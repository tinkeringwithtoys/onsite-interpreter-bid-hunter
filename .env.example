# =============================================================================
# Copy this to .env and fill in real values.  NEVER commit .env - see .gitignore
# =============================================================================
#
# ROTATE FIRST. Every credential you pasted into chat should be considered
# public. Generate new ones, then put the NEW values here.
#
# Validate before running anything:
#     python3 envfile.py --check .env
#
# =============================================================================

# --- Email ------------------------------------------------------------------
# One variable per line. Two on one line silently breaks the second one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The Gmail account that AUTHENTICATES.
SMTP_USER=dinalad042@gmail.com

# A 16-character Gmail APP PASSWORD, not your account password.
# Requires 2-Step Verification: myaccount.google.com/apppasswords
# Spaces are stripped automatically, so "abcd efgh ijkl mnop" is fine.
SMTP_PASSWORD=REPLACE_WITH_NEW_APP_PASSWORD

# MUST be identical to SMTP_USER for Gmail. Gmail rewrites or rejects a From
# header that does not match the authenticated account. Your old file had the
# literal placeholder "your-address@gmail.com" here, which would have failed.
SMTP_FROM=dinalad042@gmail.com

# Where digests go. Comma-separate for several recipients.
ALERT_EMAIL=aladinsliti@gmail.com

# --- Scorer -----------------------------------------------------------------
AGNES_API_KEY=REPLACE_WITH_NEW_KEY
AGNES_ENDPOINT=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=agnes-2.5-flash

# --- Tunisia portal (only needed for the heavy lane) ------------------------
# TUNEPS_USER=
# TUNEPS_PASSWORD=

# =============================================================================
# DELIBERATELY ABSENT: GITHUB_TOKEN / any personal access token.
#
# GitHub Actions injects GITHUB_TOKEN automatically, and the workflows declare
# `permissions: contents: write`, which is all that is needed to commit state.
# A personal access token here would add risk and buy nothing.
# =============================================================================
